{
    "name": "sd1/laravel-query-viewer",
    "description": "Floating raw SQL query viewer, per-page grouping, N+1/EXPLAIN insight, dan export tiket bug untuk aplikasi Laravel internal tim. Khusus server testing.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "debug", "sql", "query", "internal"],
    "require": {
        "php": ">=7.1",
        "illuminate/support": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/routing": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/database": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sd1\\QueryViewer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sd1\\QueryViewer\\QueryViewerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
